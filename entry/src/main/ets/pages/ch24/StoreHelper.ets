import { relationalStore } from '@kit.ArkData';
import { common } from '@kit.AbilityKit';

// Chapter 24 shared RDB helper: wraps RdbStore init + CRUD so demos stay focused.
export const DB_NAME: string = 'bill.db';
export const TABLE_NAME: string = 'bill';

// One accounting record. id is auto-generated by SQLite, so it is optional on insert.
export interface Bill {
  id?: number;
  type: number;        // 0 = expense (支出), 1 = income (收入)
  category: string;    // e.g. 餐饮 / 交通 / 工资
  amount: number;      // money, stored as REAL
  remark: string;
  createTime: number;  // epoch millis
}

// Router param for jumping from list to edit page. An explicit interface keeps the
// object literal valid under arkts-no-untyped-obj-literals (Record<string, Object> assignment trips it).
export interface EditParams {
  billId: number;
}

export class StoreHelper {
  private store: relationalStore.RdbStore | null = null;

  // Step 1+2: get RdbStore (securityLevel is required on API 12+) and create table if missing.
  async init(context: common.Context): Promise<void> {
    const config: relationalStore.StoreConfig = {
      name: DB_NAME,
      securityLevel: relationalStore.SecurityLevel.S2
    };
    this.store = await relationalStore.getRdbStore(context, config);
    await this.store.executeSql(
      `CREATE TABLE IF NOT EXISTS ${TABLE_NAME} (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        type INTEGER,
        category TEXT,
        amount REAL,
        remark TEXT,
        createTime INTEGER
      )`
    );
  }

  // Insert one row; returns the new row id (or -1 if store not ready).
  async insertBill(bill: Bill): Promise<number> {
    const store = this.store;
    if (!store) {
      return -1;
    }
    const valueBucket: relationalStore.ValuesBucket = {
      'type': bill.type,
      'category': bill.category,
      'amount': bill.amount,
      'remark': bill.remark,
      'createTime': bill.createTime
    };
    return await store.insert(TABLE_NAME, valueBucket);
  }

  // Update an existing row by id.
  async updateBill(bill: Bill): Promise<number> {
    const store = this.store;
    if (!store || bill.id === undefined) {
      return 0;
    }
    const valueBucket: relationalStore.ValuesBucket = {
      'type': bill.type,
      'category': bill.category,
      'amount': bill.amount,
      'remark': bill.remark
    };
    const predicates = new relationalStore.RdbPredicates(TABLE_NAME);
    predicates.equalTo('id', bill.id);
    return await store.update(valueBucket, predicates);
  }

  // Delete one row by id.
  async deleteBill(id: number): Promise<number> {
    const store = this.store;
    if (!store) {
      return 0;
    }
    const predicates = new relationalStore.RdbPredicates(TABLE_NAME);
    predicates.equalTo('id', id);
    return await store.delete(predicates);
  }

  // Query with an optional RdbPredicates; if omitted, returns all rows.
  async queryBills(predicates?: relationalStore.RdbPredicates): Promise<Bill[]> {
    const store = this.store;
    if (!store) {
      return [];
    }
    const p = predicates ?? new relationalStore.RdbPredicates(TABLE_NAME);
    const resultSet = await store.query(p, ['id', 'type', 'category', 'amount', 'remark', 'createTime']);
    const list: Bill[] = [];
    if (resultSet.rowCount > 0) {
      resultSet.goToFirstRow();
      do {
        const item: Bill = {
          id: resultSet.getLong(resultSet.getColumnIndex('id')),
          type: resultSet.getLong(resultSet.getColumnIndex('type')),
          category: resultSet.getString(resultSet.getColumnIndex('category')),
          amount: resultSet.getDouble(resultSet.getColumnIndex('amount')),
          remark: resultSet.getString(resultSet.getColumnIndex('remark')),
          createTime: resultSet.getLong(resultSet.getColumnIndex('createTime'))
        };
        list.push(item);
      } while (resultSet.goToNextRow());
    }
    resultSet.close(); // MUST close ResultSet, otherwise it leaks native resources
    return list;
  }

  // Convenience: all rows ordered by time descending.
  async getAll(): Promise<Bill[]> {
    const p = new relationalStore.RdbPredicates(TABLE_NAME);
    p.orderByDesc('createTime');
    return await this.queryBills(p);
  }
}
