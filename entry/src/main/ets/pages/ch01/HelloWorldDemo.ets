// Chapter 1 demo: the canonical Hello World generated by an Empty Ability project.
// @Entry marks the page entry; @State makes `message` a state variable that drives UI refresh.
@Entry
@Component
struct HelloWorldDemo {
  @State message: string = 'Hello World'

  build() {
    Row() {
      Column() {
        Text(this.message)
          .fontSize(50)
          .fontWeight(FontWeight.Bold)
          .onClick(() => {
            // Change the state variable -> the Previewer refreshes automatically (Ctrl/Cmd + S).
            this.message = 'Hello ArkUI!'
          })
      }
      .width('100%')
    }
    .height('100%')
  }
}
